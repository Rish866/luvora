# ---- Luvora backend configuration ----
# Copy to .env.development / .env.test / .env.production and fill in.
# NEVER commit real secrets. Use a secret manager in production.

NODE_ENV=development
PORT=4000

# PostgreSQL connection string.
# Docker (developer machine):   postgres://app:app@localhost:5432/luvora_dev
# Sandbox native PG (socket):   postgres://app@/luvora_dev?host=/path/to/socket
DATABASE_URL=postgres://app:app@localhost:5432/luvora_dev

# JWT secrets — generate strong random values, e.g. `openssl rand -base64 48`.
# Separate secrets for access and refresh so one leaking doesn't compromise both.
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL_SECONDS=900          # 15 minutes
JWT_REFRESH_TTL_SECONDS=2592000     # 30 days

# bcrypt cost factor (10-12 is a sane range).
BCRYPT_ROUNDS=12

# CORS allowed origins (comma-separated). Mobile app typically needs none.
CORS_ORIGINS=

# Rate limiting (per IP, sliding window).
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_MAX=10

# WebSocket chat (Increment 3) shares the HTTP server/PORT above at /ws/chat and
# reuses JWT_ACCESS_SECRET for handshake auth, so it needs no extra config.
# WebSocket presence/delivery state is process-local (single instance).

# ---- Future increments (interfaces exist; adapters mocked until configured) ----
# Object storage (private media) — S3-compatible
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_SIGNED_URL_TTL_SECONDS=300

# Push notifications (FCM)
FCM_PROJECT_ID=
FCM_CREDENTIALS_JSON=

# Image moderation provider
MODERATION_PROVIDER=mock
MODERATION_API_KEY=

# Redis (presence / pub-sub for horizontal WS scaling)
REDIS_URL=

# Developer mode — MUST be false in production.
DEVELOPER_MODE=false

# ---- Media (Increment 5) ----
# All have safe defaults; none are secrets. Local storage needs no credentials.
MEDIA_MAX_BYTES=10485760            # 10 MB
MEDIA_MAX_WIDTH=8000
MEDIA_MAX_HEIGHT=8000
MEDIA_MAX_ATTACHMENTS_PER_MESSAGE=5
MEDIA_MAX_TOTAL_MESSAGE_BYTES=26214400   # 25 MB
MEDIA_THUMBNAIL_SIZE=320            # longest edge, px
MEDIA_STORAGE_PROVIDER=local        # local (future: s3, r2)
MEDIA_LOCAL_STORAGE_PATH=           # empty = per-process temp dir
MEDIA_SCAN_MODE=test                # test (dev stub) | disabled. Prod: real scanner adapter.
MEDIA_MODERATION_MODE=test          # test (dev stub) | disabled. Prod: real provider.
MEDIA_UNKNOWN_SCAN_POLICY=quarantine  # quarantine (safe) | allow
MEDIA_SIGNED_URL_TTL_SECONDS=300
