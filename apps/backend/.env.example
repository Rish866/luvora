# ---- Luvora backend configuration ----
# Copy to .env.development / .env.test / .env.production and fill in.
# NEVER commit real secrets. Use a secret manager in production.

NODE_ENV=development
PORT=4000

# PostgreSQL connection string.
# Docker (developer machine):   postgres://app:app@localhost:5432/luvora_dev
# Sandbox native PG (socket):   postgres://app@/luvora_dev?host=/path/to/socket
DATABASE_URL=postgres://app:app@localhost:5432/luvora_dev

# JWT secrets — generate strong random values, e.g. `openssl rand -base64 48`.
# Separate secrets for access and refresh so one leaking doesn't compromise both.
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL_SECONDS=900          # 15 minutes
JWT_REFRESH_TTL_SECONDS=2592000     # 30 days

# bcrypt cost factor (10-12 is a sane range).
BCRYPT_ROUNDS=12

# CORS allowed origins (comma-separated). CORS_ALLOWED_ORIGINS is the canonical
# name (CORS_ORIGINS is a legacy alias). In production this MUST be an explicit
# allowlist (no wildcard with credentials) or the app refuses to boot.
CORS_ALLOWED_ORIGINS=
CORS_ORIGINS=

# Rate limiting (per IP, sliding window).
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_MAX=10

# WebSocket chat (Increment 3) shares the HTTP server/PORT above at /ws/chat and
# reuses JWT_ACCESS_SECRET for handshake auth, so it needs no extra config.

# ---- Notification delivery + presence (Increment 8) ----
# All have safe defaults; NONE require secrets for development/test.
# Push delivery master switch. false (default) = DisabledPushProvider (no
# external delivery); in-app notifications + WebSocket events are unaffected.
NOTIFICATION_PUSH_ENABLED=false
# Provider used when push is enabled:
#   disabled = no delivery (safe default)
#   test     = deterministic in-process provider (tests / dev; no network)
#   fcm/apns = PLACEHOLDERS — require a real SDK + credentials; fail safely until
#              implemented. Do NOT set these without a real integration.
PUSH_PROVIDER=disabled
# Device registration rate limit (per IP window).
DEVICE_RATE_LIMIT_MAX=30
# Presence backend: local (default, process-local) | distributed (placeholder;
# degrades to local until a shared-store client is wired — needs REDIS_URL).
PRESENCE_BACKEND=local
# Realtime event bus: local (default, in-process) | distributed (placeholder).
REALTIME_BUS=local
# Presence heartbeat/TTL (seconds). A live connection refreshes its TTL on each
# heartbeat; a connection with no heartbeat within the TTL is reaped → OFFLINE.
PRESENCE_HEARTBEAT_SECONDS=30
PRESENCE_TTL_SECONDS=90

# ---- Future integrations (interfaces exist; adapters mocked until configured) ----
# Object storage (private media) — S3-compatible
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_SIGNED_URL_TTL_SECONDS=300

# Push notifications — FCM (Android) placeholder. Empty = NOT configured.
# Both must be set (via a secret manager; NEVER commit) for the FCM provider to
# be considered configured.
FCM_PROJECT_ID=
FCM_CREDENTIALS_JSON=

# Push notifications — APNs (iOS) placeholder. All three required to configure.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=

# Image moderation provider
MODERATION_PROVIDER=mock
MODERATION_API_KEY=

# Redis — optional shared store for a future distributed presence / realtime
# bus (horizontal WS scaling). Empty = process-local (the default). NEVER a
# required dependency; no test uses it.
REDIS_URL=

# ---- Background jobs + worker (Increment 9) ----
# Durable PostgreSQL-backed job queue. No Redis/broker required. The API server
# does NOT need a worker; run one separately with `npm run worker`.
# Set true to ALSO run an embedded worker inside the API process (off by default
# — the normal API behaviour is unchanged).
JOB_WORKER_ENABLED=false
JOB_WORKER_CONCURRENCY=5           # max jobs a worker processes concurrently
JOB_POLL_INTERVAL_MS=500           # delay between polls when the queue is empty
JOB_LEASE_SECONDS=60               # how long a claimed job's lease lasts
JOB_LEASE_HEARTBEAT_SECONDS=20     # how often a running job extends its lease
JOB_MAX_ATTEMPTS=5                 # attempts before dead-lettering
JOB_RETRY_BASE_DELAY_MS=1000       # backoff base (exponential)
JOB_RETRY_MAX_DELAY_MS=60000       # backoff cap
JOB_RETRY_JITTER=true              # add full jitter to backoff
JOB_RECLAIM_INTERVAL_SECONDS=30    # how often expired leases are reclaimed
JOB_SHUTDOWN_GRACE_MS=15000        # time in-flight jobs get to finish on shutdown
JOB_SUCCESS_RETENTION_DAYS=7       # keep SUCCEEDED/CANCELLED jobs this long
JOB_DEAD_RETENTION_DAYS=30         # keep DEAD jobs longer (for investigation)
JOB_MAX_QUEUE_DEPTH=0              # backpressure cap (0 = unbounded)

# ---- Observability & operational controls (Increment 10) ----
# Structured-logger level (debug|info|warn|error|silent; any case). Forced to
# 'silent' automatically under NODE_ENV=test.
LOG_LEVEL=info
# /metrics endpoint. Safe defaults: enabled but requires an ADMIN access token.
# Disabled => /metrics returns 404. Metrics are PROCESS-LOCAL (not aggregated
# across instances; a future scrape layer would do that).
METRICS_ENABLED=true
METRICS_REQUIRE_AUTH=true
# Bounded DB probe timeouts for /health and /ready (ms).
HEALTH_DB_TIMEOUT_MS=2000
READINESS_DB_TIMEOUT_MS=2000
# Queue-pressure thresholds surfaced in worker health + metrics (claimable
# depth / oldest-pending age seconds). Critical/SAFETY jobs are never dropped.
JOB_QUEUE_WARNING_DEPTH=100
JOB_QUEUE_CRITICAL_DEPTH=1000
JOB_QUEUE_MAX_AGE_SECONDS=300
# Worker is reported UNHEALTHY if enabled but not polled within this window, or
# after this many consecutive claim-loop errors. (A DISABLED worker is never
# marked unhealthy.)
WORKER_UNHEALTHY_POLL_SECONDS=120
WORKER_UNHEALTHY_ERROR_STREAK=10
# Operational-event retention (days). SEPARATE from audit logs, which are
# append-only and never deleted by cleanup.
OPERATIONAL_EVENT_RETENTION_DAYS=90

# Developer mode — MUST be false in production.
DEVELOPER_MODE=false

# ---- Media (Increment 5) ----
# All have safe defaults; none are secrets. Local storage needs no credentials.
MEDIA_MAX_BYTES=10485760            # 10 MB
MEDIA_MAX_WIDTH=8000
MEDIA_MAX_HEIGHT=8000
MEDIA_MAX_ATTACHMENTS_PER_MESSAGE=5
MEDIA_MAX_TOTAL_MESSAGE_BYTES=26214400   # 25 MB
MEDIA_THUMBNAIL_SIZE=320            # longest edge, px
MEDIA_STORAGE_PROVIDER=local        # local (future: s3, r2)
MEDIA_LOCAL_STORAGE_PATH=           # empty = per-process temp dir
MEDIA_SCAN_MODE=test                # test (dev stub) | disabled. Prod: real scanner adapter.
MEDIA_MODERATION_MODE=test          # test (dev stub) | disabled. Prod: real provider.
MEDIA_UNKNOWN_SCAN_POLICY=quarantine  # quarantine (safe) | allow
MEDIA_SIGNED_URL_TTL_SECONDS=300

# ---- Security hardening (Increment 11) ----
# Number of trusted reverse proxies in front of the app. 0 = direct connection
# (do not trust X-Forwarded-For). Behind one LB/ingress, set 1. Determines the
# client IP used for abuse control.
TRUST_PROXY_HOPS=0

# Abuse control (sliding-window limiter). Independent of the legacy rate
# limiter; effective even under test. MAX_KEYS bounds the in-memory backend.
ABUSE_GUARD_ENABLED=true
ABUSE_GUARD_MAX_KEYS=100000

# ---- Distributed abuse backend (Increment 12) ----
# Which backend coordinates abuse/rate-limit state:
#   memory → process-local (default; dev/test/single-instance). NOT globally
#            enforced — each instance has its own counters.
#   redis  → shared across instances via REDIS_URL (atomic). Use this in any
#            multi-instance production deployment.
ABUSE_BACKEND=memory
# Redis connection string (required when ABUSE_BACKEND=redis). Never logged.
# REDIS_URL is shared with the (placeholder) presence/realtime settings.
REDIS_URL=
# Namespace prefix for abuse keys in Redis (clear() only touches this prefix).
REDIS_KEY_PREFIX=luvora
# Per-operation Redis timeout (ms). Keep small so a slow Redis degrades per the
# fail policy rather than hanging requests.
ABUSE_REDIS_TIMEOUT_MS=100
# Behaviour when the Redis abuse backend is unavailable/errors:
#   closed → DENY security-critical throttled checks (fail CLOSED; default/safest;
#            REQUIRED in production — do not silently stop protecting).
#   open   → allow (availability over strict enforcement; forbidden in prod+redis).
ABUSE_FAIL_POLICY=closed
# HMAC secret used to fingerprint identifiers (IP/email/user) BEFORE they are
# used as Redis keys, so no raw PII lands in Redis. Empty → derived from
# JWT_ACCESS_SECRET. A dedicated strong value is recommended in production.
ABUSE_FINGERPRINT_SECRET=
# Readiness PING timeout (ms) for the Redis abuse backend.
READINESS_REDIS_TIMEOUT_MS=1000

# Login brute-force / credential-stuffing throttle (TEMPORARY, not a lockout).
# Keyed by both client IP and target account. After MAX_FAILURES failures within
# the window, that dimension is throttled for THROTTLE_SECONDS.
LOGIN_MAX_FAILURES=10
LOGIN_FAILURE_WINDOW_SECONDS=900
LOGIN_THROTTLE_SECONDS=300

# Request input limits. Oversized JSON bodies -> 413; over-long URLs -> 413.
JSON_BODY_LIMIT_BYTES=1048576       # 1 MB
MAX_URL_LENGTH=2048

# HTTP Strict Transport Security. Enable ONLY when TLS is terminated in front
# and you intend browsers to pin HTTPS. Harmful over plain HTTP.
HSTS_ENABLED=false
HSTS_MAX_AGE_SECONDS=15552000       # 180 days

# WebSocket limits.
WS_MAX_CONNECTIONS_PER_USER=10
WS_MAX_FRAME_BYTES=65536            # inbound frame cap (maxPayload)
WS_EVENT_WINDOW_MS=10000            # per-connection event throttle window
WS_EVENT_MAX=50                     # max inbound events per window

# Media decompression-bomb defence: reject images whose width*height exceeds
# this, in addition to the byte + per-dimension limits above.
MEDIA_MAX_PIXELS=50000000           # 50 MP

# Security-event retention (days). SEPARATE from audit logs (append-only, never
# pruned). Pruned by the BACKGROUND_JOB_CLEANUP durable job.
SECURITY_EVENT_RETENTION_DAYS=90

# Developer mode MUST be false in production (also enforced by the fail-fast).
