{
  "name": "@luvora/backend",
  "version": "0.1.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "start": "node dist/server.js",
    "worker": "node -r ts-node/register src/jobs/workerMain.ts",
    "worker:build": "node dist/jobs/workerMain.js",
    "migrate:up": "node -r ts-node/register src/db/migrate.ts up",
    "migrate:down": "node -r ts-node/register src/db/migrate.ts down",
    "seed": "node -r ts-node/register src/db/seed.ts",
    "test": "vitest run",
    "verify": "node -r ts-node/register scripts/verify.ts",
    "verify:redis": "VERIFY_WITH_REDIS=1 node -r ts-node/register scripts/verify.ts"
  },
  "dependencies": {
    "@luvora/shared": "*",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "file-type": "^21.3.1",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "sharp": "^0.35.5",
    "ws": "^8.22.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "@types/ws": "^8.18.2",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
