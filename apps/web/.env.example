# Luvora web frontend — PUBLIC configuration only.
# Vite only exposes variables prefixed with VITE_ to the browser bundle.
# NEVER put secrets, service-role keys, or database credentials here.

# Base URL of the Luvora backend HTTP API (no trailing slash).
# When unset the app makes same-origin relative requests ("" -> relative),
# which suits a reverse-proxy / same-origin production deployment. For local
# dev point it at your running backend (cross-origin: the backend must allow
# http://localhost:5173 via CORS_ALLOWED_ORIGINS).
VITE_API_BASE_URL=http://localhost:4000

# Base URL of the backend WebSocket server (ws:// or wss://). When unset it is
# derived from VITE_API_BASE_URL (http->ws, https->wss).
VITE_WS_BASE_URL=ws://localhost:4000
